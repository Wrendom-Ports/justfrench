                            <div class="form-group">
                                <textarea name="message" class="form-control" rows="8" placeholder="Message" data-en-placeholder="Message" data-fr-placeholder="Message" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary" data-en="Send Message" data-fr="Envoyer le message">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
